                    "disabled": false,
                    "description": "(Required) Agora access key (cleartext), sent as `Authorization: Bearer <accessKey>`. Used only by POST /v0/auth/token to mint a session JWT.",
                    "key": "Authorization",
                    "value": "string"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
